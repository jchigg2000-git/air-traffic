+++ b/web/src/pages/Welcome.test.tsx
@@ -0,0 +1,74 @@
+import { describe, it, expect } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router-dom'
+import Welcome from './Welcome.tsx'
+import {
+  LANDING,
+  type HeroSection,
+  type VendorsSection,
+  type DispositionsSection,
+  type PlanesSection,
+} from './landing/content.ts'
+import { dispMeta } from '../lib/dispositions.ts'
+
+function renderWelcome() {
+  return render(
+    <MemoryRouter initialEntries={['/welcome']}>
+      <Welcome />
+    </MemoryRouter>,
+  )
+}
+
+const hero = LANDING.find((s): s is HeroSection => s.kind === 'hero')!
+const vendors = LANDING.find((s): s is VendorsSection => s.kind === 'vendors')!
+const dispositions = LANDING.find((s): s is DispositionsSection => s.kind === 'dispositions')!
+const planes = LANDING.find((s): s is PlanesSection => s.kind === 'planes')!
+
+describe('Welcome landing page', () => {
+  it('renders the hero headline', () => {
+    renderWelcome()
+    expect(screen.getByRole('heading', { level: 1, name: hero.headline })).toBeInTheDocument()
+  })
+
+  it('renders all 16 vendor names', () => {
+    renderWelcome()
+    const names = vendors.tiers.flatMap((t) => t.vendors.map((v) => v.name))
+    expect(names).toHaveLength(16)
+    for (const name of names) {
+      expect(document.body).toHaveTextContent(name)
+    }
+  })
+
+  it('renders all 5 disposition labels from the shared lib', () => {
+    renderWelcome()
+    expect(dispositions.keys).toHaveLength(5)
+    for (const key of dispositions.keys) {
+      expect(document.body).toHaveTextContent(dispMeta(key).label)
+    }
+  })
+
+  it('renders the 3 control-plane names', () => {
+    renderWelcome()
+    const names = planes.planes.map((p) => p.name)
+    expect(names).toEqual(['Developer Workflow', 'Data Policy', 'Budget'])
+    for (const name of names) {
+      expect(document.body).toHaveTextContent(name)
+    }
+  })
+
+  it('points the primary CTA to the Flight Deck and the secondary to the Gateway Harness', () => {
+    renderWelcome()
+
+    const primaries = screen.getAllByRole('link', { name: 'Enter the Control Tower' })
+    expect(primaries.length).toBeGreaterThan(0)
+    for (const link of primaries) {
+      expect(link).toHaveAttribute('href', '/')
+    }
+
+    const secondaries = screen.getAllByRole('link', { name: 'See redaction proof — Gateway Harness' })
+    expect(secondaries.length).toBeGreaterThan(0)
+    for (const link of secondaries) {
+      expect(link).toHaveAttribute('href', '/settings/harness')
+    }
+  })
+})
