+
+// Test-only config. The app itself is built via vite.config.ts; this keeps the
+// jsdom + testing-library wiring out of the build config.
+export default defineConfig({
+  plugins: [react()],
+  test: {
+    environment: 'jsdom',
+    globals: true,
+    setupFiles: ['./src/test/setup.ts'],
+    include: ['src/**/*.test.{ts,tsx}'],
