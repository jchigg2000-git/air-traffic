@@ -0,0 +1,326 @@
+// ─────────────────────────────────────────────────────────────────────────────
+// The one renderer. `SectionRenderer` switches on `section.kind` and returns the
+// presentational markup for that section — nothing else in the landing page
+// hand-writes per-section JSX. Content (content.ts) and presentation (here) are
+// orthogonal: content decides *what* and *in what order*; this file decides *how
+// it looks*. Small internal helpers are fine; the dispatch is a single switch.
+//
+// Disposition meta is resolved from the shared lib so the legend can never drift
+// from the rest of the app.
+// ─────────────────────────────────────────────────────────────────────────────
+
+import { Link } from 'react-router-dom'
+import Brand from '../../components/Brand.tsx'
+import VendorGlyph from '../../components/VendorGlyph.tsx'
+import { dispMeta } from '../../lib/dispositions.ts'
+import type { Section, Cta, Chip } from './content.ts'
+
+export default function SectionRenderer({ section }: { section: Section }) {
+  switch (section.kind) {
+    case 'hero':
+      return (
+        <header className="relative overflow-hidden">
+          <div className="grid-fade pointer-events-none absolute inset-x-0 top-0 h-[520px]" />
+          <div className="relative mx-auto flex max-w-3xl flex-col items-center px-5 pb-16 pt-16 text-center sm:pt-24">
+            <Brand size={40} />
+            <p className="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-accent">{section.eyebrow}</p>
+            <h1 className="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">
+              {section.headline}
+            </h1>
+            <p className="mt-5 max-w-2xl text-pretty text-base text-muted sm:text-lg">{section.subhead}</p>
+            <div className="mt-8 flex flex-wrap items-center justify-center gap-3">
+              {section.ctas.map((c) => (
+                <CtaButton key={c.to + c.label} cta={c} />
+              ))}
+            </div>
+            <div className="mt-8 flex flex-wrap items-center justify-center gap-2.5">
+              {section.chips.map((c) => (
+                <ChipPill key={c.label} chip={c} />
+              ))}
+            </div>
+          </div>
+        </header>
+      )
+
+    case 'problem':
+      return (
+        <Band>
+          <Eyebrow>{section.eyebrow}</Eyebrow>
+          <SectionTitle>{section.title}</SectionTitle>
+          <div className="mt-6 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-start">
+            <div className="flex flex-col gap-4">
+              {section.body.map((p, i) => (
+                <p key={i} className="text-pretty text-base leading-relaxed text-muted">
+                  {p}
+                </p>
+              ))}
+            </div>
+            <div
+              className="panel p-5"
+              style={{
+                borderColor: 'color-mix(in srgb, var(--accent) 40%, transparent)',
+                background: 'color-mix(in srgb, var(--accent) 7%, var(--panel))',
+              }}
+            >
+              <div className="text-xs font-semibold uppercase tracking-wider text-accent">{section.callout.label}</div>
+              <p className="mt-2 text-sm leading-relaxed text-fg">{section.callout.text}</p>
+            </div>
+          </div>
+        </Band>
+      )
+
+    case 'planes':
+      return (
+        <Band>
+          <Eyebrow>{section.eyebrow}</Eyebrow>
+          <SectionTitle>{section.title}</SectionTitle>
+          <Lede>{section.subhead}</Lede>
+          <div className="mt-8 grid gap-4 lg:grid-cols-3">
+            {section.planes.map((p) => (
+              <div key={p.key} className="panel flex flex-col p-5">
+                <div className="flex items-center gap-3">
+                  <span
+                    aria-hidden
+                    className="grid h-10 w-10 place-items-center rounded-xl text-lg text-accent"
+                    style={{ background: 'color-mix(in srgb, var(--accent) 12%, transparent)' }}
+                  >
+                    {p.glyph}
+                  </span>
+                  <h3 className="text-base font-semibold">{p.name}</h3>
+                </div>
+                <p className="mt-3 text-sm leading-relaxed text-muted">{p.blurb}</p>
+                <ul className="mt-4 flex flex-col gap-2 border-t border-line pt-4">
+                  {p.points.map((pt) => (
+                    <li key={pt} className="flex items-start gap-2 text-sm text-fg">
+                      <span aria-hidden className="mt-1 text-accent">
+                        ›
+                      </span>
+                      {pt}
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            ))}
+          </div>
+        </Band>
+      )
+
+    case 'dispositions':
+      return (
+        <Band>
+          <Eyebrow>{section.eyebrow}</Eyebrow>
+          <SectionTitle>{section.title}</SectionTitle>
+          <Lede>{section.subhead}</Lede>
+          <div className="mt-8 flex flex-col gap-3">
+            {section.keys.map((k) => {
+              const m = dispMeta(k)
+              return (
+                <div key={k} className="panel flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:gap-4">
+                  <span
+                    className="inline-flex w-fit shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-sm font-medium"
+                    style={{
+                      color: m.color,
+                      borderColor: `color-mix(in srgb, ${m.color} 45%, transparent)`,
+                      background: `color-mix(in srgb, ${m.color} 12%, transparent)`,
+                    }}
+                  >
+                    <span aria-hidden style={{ lineHeight: 1 }}>
+                      {m.glyph}
+                    </span>
+                    {m.label}
+                  </span>
+                  <span className="text-sm text-muted">{m.blurb}</span>
+                </div>
+              )
+            })}
+          </div>
+          <div
+            className="mt-5 flex flex-col gap-1 rounded-xl border p-4 sm:flex-row sm:items-baseline sm:gap-3"
+            style={{
+              borderColor: 'color-mix(in srgb, var(--unverified) 40%, transparent)',
+              background: 'color-mix(in srgb, var(--unverified) 8%, transparent)',
+            }}
+          >
+            <span className="text-xs font-semibold uppercase tracking-wider text-unverified">
+              {section.truthfulness.label}
+            </span>
+            <span className="text-sm text-fg">{section.truthfulness.text}</span>
+          </div>
+        </Band>
+      )
+
+    case 'vendors':
+      return (
+        <Band>
+          <Eyebrow>{section.eyebrow}</Eyebrow>
+          <SectionTitle>{section.title}</SectionTitle>
+          <Lede>{section.subhead}</Lede>
+          <div className="mt-8 flex flex-col gap-4">
+            {section.tiers.map((t) => (
+              <div key={t.tier} className="panel p-5">
+                <div className="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-3">
+                  <h3 className="text-sm font-semibold tracking-wide">{t.label}</h3>
+                  <span className="text-xs text-faint">{t.note}</span>
+                </div>
+                <div className="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-6">
+                  {t.vendors.map((v) => (
+                    <div
+                      key={v.id}
+                      className="panel-2 flex items-center gap-2.5 px-3 py-2.5"
+                      style={{ background: 'var(--panel2)' }}
+                    >
+                      <VendorGlyph id={v.id} size={26} />
+                      <span className="min-w-0 truncate text-sm font-medium">{v.name}</span>
+                    </div>
+                  ))}
+                </div>
+              </div>
+            ))}
+          </div>
+        </Band>
+      )
+
+    case 'how':
+      return (
+        <Band>
+          <Eyebrow>{section.eyebrow}</Eyebrow>
+          <SectionTitle>{section.title}</SectionTitle>
+          <Lede>{section.subhead}</Lede>
+          <ol className="mt-8 grid gap-4 lg:grid-cols-3">
+            {section.steps.map((s, i) => (
+              <li key={s.title} className="panel flex flex-col p-5">
+                <span
+                  aria-hidden
+                  className="grid h-8 w-8 place-items-center rounded-lg font-mono text-sm font-semibold text-accent"
+                  style={{ background: 'color-mix(in srgb, var(--accent) 12%, transparent)' }}
+                >
+                  {i + 1}
+                </span>
+                <h3 className="mt-3 text-base font-semibold">{s.title}</h3>
+                <p className="mt-2 text-sm leading-relaxed text-muted">{s.body}</p>
+              </li>
+            ))}
+          </ol>
+          <div
+            className="mt-5 rounded-xl border p-5"
+            style={{
+              borderColor: 'color-mix(in srgb, var(--proxy) 40%, transparent)',
+              background: 'color-mix(in srgb, var(--proxy) 8%, transparent)',
+            }}
+          >
+            <div className="flex items-center gap-2">
+              <span aria-hidden className="text-proxy">
+                ✚
+              </span>
+              <span className="text-xs font-semibold uppercase tracking-wider text-proxy">{section.gateway.label}</span>
+            </div>
+            <p className="mt-2 text-sm leading-relaxed text-fg">{section.gateway.text}</p>
+          </div>
+        </Band>
+      )
+
+    case 'cta':
+      return (
+        <Band>
+          <div className="panel relative overflow-hidden px-6 py-12 text-center sm:px-12">
+            <div className="grid-fade pointer-events-none absolute inset-x-0 top-0 h-40" />
+            <div className="relative mx-auto flex max-w-2xl flex-col items-center">
+              <h2 className="text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{section.title}</h2>
+              <p className="mt-4 text-pretty text-base text-muted sm:text-lg">{section.body}</p>
+              <div className="mt-7 flex flex-wrap items-center justify-center gap-3">
+                {section.ctas.map((c) => (
+                  <CtaButton key={c.to + c.label} cta={c} />
+                ))}
+              </div>
+              <p className="mt-8 max-w-xl text-xs leading-relaxed text-faint">{section.honesty}</p>
+            </div>
+          </div>
+        </Band>
+      )
+
+    case 'footer':
+      return (
+        <footer className="mx-auto max-w-5xl px-5 pb-12 pt-4">
+          <div className="flex flex-col items-center gap-3 border-t border-line pt-8 text-center sm:flex-row sm:justify-between sm:text-left">
+            <div className="flex items-center gap-2.5">
+              <Brand size={22} />
+            </div>
+            <div className="flex flex-col text-xs text-faint sm:items-end">
+              <span className="text-muted">{section.tagline}</span>
+              <span>{section.note}</span>
+            </div>
+          </div>
+        </footer>
+      )
+
+    default:
+      return assertNever(section)
+  }
+}
+
+// ── Internal presentational helpers ──────────────────────────────────────────
+
+function Band({ children }: { children: React.ReactNode }) {
+  return (
+    <section className="mx-auto max-w-5xl px-5 py-14">
+      <div>{children}</div>
+    </section>
+  )
+}
+
+function Eyebrow({ children }: { children: React.ReactNode }) {
+  return <p className="text-xs font-semibold uppercase tracking-[0.2em] text-accent">{children}</p>
+}
+
+function SectionTitle({ children }: { children: React.ReactNode }) {
+  return <h2 className="mt-3 text-balance text-2xl font-semibold tracking-tight sm:text-3xl">{children}</h2>
+}
+
+function Lede({ children }: { children: React.ReactNode }) {
+  return <p className="mt-3 max-w-2xl text-pretty text-base text-muted">{children}</p>
+}
+
+function CtaButton({ cta }: { cta: Cta }) {
+  const base =
+    'inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent'
+  if (cta.variant === 'primary') {
+    return (
+      <Link
+        to={cta.to}
+        className={`${base} text-bg`}
+        style={{ background: 'var(--accent)' }}
+      >
+        {cta.label}
+      </Link>
+    )
+  }
+  if (cta.variant === 'secondary') {
+    return (
+      <Link to={cta.to} className={`${base} border border-line bg-panel2 text-fg hover:border-accent`}>
+        {cta.label}
+      </Link>
+    )
+  }
+  return (
+    <Link to={cta.to} className={`${base} text-muted hover:text-fg`}>
+      {cta.label}
+    </Link>
+  )
+}
+
+function ChipPill({ chip }: { chip: Chip }) {
+  const color = chip.dot === 'green' ? 'var(--green)' : 'var(--accent)'
+  return (
+    <span className="flex items-center gap-2 rounded-full border border-line bg-panel2 px-3 py-1.5 text-xs text-muted">
+      <span
+        className={`inline-block h-2 w-2 rounded-full${chip.pulse ? ' pulse-dot' : ''}`}
+        style={{ background: color }}
+      />
+      {chip.label}
+    </span>
+  )
+}
+
+function assertNever(x: never): never {
+  throw new Error(`Unhandled landing section: ${JSON.stringify(x)}`)
+}
