@@ -0,0 +1,23 @@
+// Public landing page — schema-driven. This file is a thin shell: it maps the
+// declarative `LANDING` array through the single `SectionRenderer`. Adding,
+// removing, or reordering a section happens in content.ts, never here. The only
+// hand-written chrome is the fixed theme toggle (page-level, not a section).
+
+import ThemeToggle from '../components/ThemeToggle.tsx'
+import { LANDING } from './landing/content.ts'
+import SectionRenderer from './landing/SectionRenderer.tsx'
+
+export default function Welcome() {
+  return (
+    <div className="relative min-h-screen">
+      <div className="fixed right-4 top-4 z-10">
+        <ThemeToggle />
+      </div>
+      <main>
+        {LANDING.map((section, i) => (
+          <SectionRenderer key={i} section={section} />
+        ))}
+      </main>
+    </div>
+  )
+}
