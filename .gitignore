.DS_Store

# Go build artifacts
/air-traffic-server
/air-traffic-gateway
*.test

# Durable local state: harness (ratchet series, promoted corpus, pattern pack)
# and the keystore (keys.json — digests, but still not ours to commit)
/data/

# Phase 2 frontend
web/node_modules/
web/dist/

# Local secrets minted by scripts/dev-env.sh
.env

# Claude Code local scratch and runtime state. These are ignored on the author's
# machine via .git/info/exclude and ~/.gitignore_global, neither of which travels with
# a clone — so the whole directory is ignored here, or a contributor's `git add -A`
# sweeps in session metadata and, worse, the settings.local.json Claude Code writes on
# the first permission grant: tool allowlists and absolute paths from their machine.
# `.claude/*` rather than `.claude/` because git will not descend into an excluded
# directory, and the shared, deliberately-checked-in pieces below are negations.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/skills/
CLAUDE.local.md
